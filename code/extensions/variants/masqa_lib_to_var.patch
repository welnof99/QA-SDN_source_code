+def least_loaded(flows):
+    """Capacity-aware greedy: flows in priority order (EF, AF, BE; larger demand first). Each flow takes the
+       candidate path whose most-utilised arc (after adding the flow) is least utilised, among paths that fit."""
+    order = sorted(flows, key=lambda f: (-f["w"], -f["demand"]))
+    load = np.zeros(len(TOPO["links"])); out = {f["id"]: None for f in flows}
+    for f in order:
+        best = None; best_u = None
+        for p, pl in enumerate(f["paths"]):
+            new = load[list(pl)] + f["demand"]
+            if np.all(new <= CAP[list(pl)] + 1e-9):
+                u = float(np.max(new / CAP[list(pl)]))
+                if best_u is None or u < best_u - 1e-12:
+                    best, best_u = p, u
+        if best is not None:
+            out[f["id"]] = best
+            load[list(f["paths"][best])] += f["demand"]
+    return out
